/* =========================================================
   DEFAITE
========================================================= */

function showDefeat(message) {

    game.finished = true;

    document.getElementById("gameScreen")
        .classList.add("hidden");

    document.getElementById("endScreen")
        .classList.remove("hidden");

    document.getElementById("endCard")
        .innerHTML = `

        <h1>Mauvaise fin</h1>

        <div class="endSubtitle">
            La journée ne s'est pas terminée comme prévu.
        </div>

        <div class="endText">

            <p>
                ${message}
            </p>

            <br>

            <p>
                Vous quittez finalement le bureau,
                mais vous savez déjà que demain
                sera compliqué.
            </p>

        </div>

        <div class="finalStats">

            <div class="finalStat">
                Energie
                <strong>
                    ${game.energy}
                </strong>
            </div>

            <div class="finalStat">
                Budget
                <strong>
                    ${formatMoney(game.money)}
                </strong>
            </div>

        </div>

        <button
            class="restartButton"
            onclick="startGame()"
        >
            Recommencer
        </button>

    `;

}


/* =========================================================
   FIN SECRETE
========================================================= */

function showSecretEnding() {

    game.finished = true;

    document.getElementById("gameScreen")
        .classList.add("hidden");

    document.getElementById("endScreen")
        .classList.remove("hidden");

    document.getElementById("endCard")
        .innerHTML = `

        <h1>Fin alternative</h1>

        <div class="endSubtitle">
            Vous avez acheté votre tranquillité.
        </div>

        <div class="endText">

            <p>
                Karine accepte de prendre la réunion
                en charge à votre place.
            </p>

            <br>

            <p>
                Vous avez dépensé 15 000 € pour obtenir
                cette solution, mais vous gagnez énormément
                de temps et d'énergie.
            </p>

            <br>

            <p>
                Vous quittez donc le bureau plus tôt.
                La journée est techniquement sauvée...
                mais Cécile risque de regarder les dépenses
                de très près demain matin.
            </p>

        </div>

        <div class="finalStats">

            <div class="finalStat">
                Energie
                <strong>
                    ${game.energy}
                </strong>
            </div>

            <div class="finalStat">
                Budget
                <strong>
                    ${formatMoney(game.money)}
                </strong>
            </div>

        </div>

        <button
            class="restartButton"
            onclick="startGame()"
        >
            Recommencer
        </button>

    `;

}


/* =========================================================
   TOAST
========================================================= */

function showToast(message) {

    const toast =
        document.getElementById("toast");

    toast.textContent =
        message;

    toast.classList.add("show");

    setTimeout(() => {

        toast.classList.remove("show");

    }, 2600);

}


/* =========================================================
   LANCEMENT
========================================================= */

game = createGame();

</script>

</body>
</html>
```
